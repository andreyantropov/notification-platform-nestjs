# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------
# Global HTTP Client Settings (Axios)
# ------------------------------------------------------------------
# Optional (default: 30000)
AXIOS_TIMEOUT_MS=30000

# ------------------------------------------------------------------
# Bitrix24 Channel
# ------------------------------------------------------------------
BITRIX_BASE_URL=https://your-domain.bitrix24.ru
BITRIX_USER_ID=1
BITRIX_AUTH_TOKEN=your_secure_token_here
# Optional (default: 10000)
BITRIX_TIMEOUT_MS=10000
# Optional (default: 1)
BITRIX_CONCURRENCY = 1;
# Optional (default: 500)
BITRIX_DELAY_MS = 500;

# ------------------------------------------------------------------
# SMTP / Email Channel
# ------------------------------------------------------------------
SMTP_HOST=smtp.mail.ru
# Optional (default: 25)
SMTP_PORT=25
# Optional (default: false)
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=your_password_here
SMTP_FROM="Example Service <no-reply@example.com>"
SMTP_SUBJECT=Notification
# Optional (default: 5000)
SMTP_GREETING_TIMEOUT_MS=5000
# Optional (default: 5000)
SMTP_SOCKET_TIMEOUT_MS=5000
# Optional (default: 5000)
SMTP_CONNECTION_TIMEOUT_MS=5000
# Optional (default: 10000)
SMTP_TIMEOUT_MS=10000
# Optional (default: 1)
SMTP_CONCURRENCY = 1;
# Optional (default: 500)
SMTP_DELAY_MS = 500;