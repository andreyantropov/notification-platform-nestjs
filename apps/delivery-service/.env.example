# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
# Optional (default: 3001)
PORT=3001
# Optional (default: info)
LOG_LEVEL=info

# ------------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------
# Global HTTP Client Settings (Axios)
# ------------------------------------------------------------------
# Optional (default: 30000)
AXIOS_TIMEOUT_MS=30000

# ------------------------------------------------------------------
# Bitrix24 Channel
# ------------------------------------------------------------------
BITRIX_BASE_URL=https://your-domain.bitrix24.ru
BITRIX_USER_ID=1
BITRIX_AUTH_TOKEN=your_secure_token_here
# Optional (default: 10000)
BITRIX_TIMEOUT_MS=10000
# Optional (default: 1)
BITRIX_CONCURRENCY=1
# Optional (default: 500)
BITRIX_DELAY_MS=500

# ------------------------------------------------------------------
# Global SMTP Client Settings
# ------------------------------------------------------------------
SMTP_HOST=smtp.mail.ru
# Optional (default: 25)
SMTP_PORT=25
# Optional (default: false)
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=your_password_here
# Optional (default: 5000)
SMTP_GREETING_TIMEOUT_MS=5000
# Optional (default: 5000)
SMTP_SOCKET_TIMEOUT_MS=5000
# Optional (default: 5000)
SMTP_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------
# Email Settings
# ------------------------------------------------------------------
EMAIL_FROM=no-reply@example.com
EMAIL_SUBJECT=Notification
# Optional (default: 10000)
EMAIL_TIMEOUT_MS=10000
# Optional (default: 1)
EMAIL_CONCURRENCY=1
# Optional (default: 500)
EMAIL_DELAY_MS=500

# ------------------------------------------------------------------
# OTel Exporters
# ------------------------------------------------------------------
# Optional
TRACES_EXPORTER_URL=http://otel-collector:4318/v1/traces
# Optional
LOGS_EXPORTER_URL=http://otel-collector:4318/v1/logs
# Optional
METRICS_EXPORTER_URL=http://otel-collector:4318/v1/metrics