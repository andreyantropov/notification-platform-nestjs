# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
# Optional (default: 3000)
PORT=3000
# Optional (default: info)
LOG_LEVEL=info

# ------------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------
# OAuth2
# ------------------------------------------------------------------
AUTH_AUDIENCE=notification-platform-api
AUTH_ISSUER_URL=https://keycloak.company.com/realms/platform
AUTH_JWKS_URI=https://keycloak.company.com/realms/platform/protocol/openid-connect/certs

# ------------------------------------------------------------------
# OTel Exporters
# ------------------------------------------------------------------
# Optional
TRACES_EXPORTER_URL=http://otel-collector:4318/v1/traces
# Optional
LOGS_EXPORTER_URL=http://otel-collector:4318/v1/logs
# Optional
METRICS_EXPORTER_URL=http://otel-collector:4318/v1/metrics